substitutions:
  friendly_name: Capof Gateway v2
  device_name: "capof-gateway-v2"
  device_description: Tesla BLE
  ble_mac_address: !secret ble_mac_address
  tesla_vin: !secret tesla_vin
  charging_amps_max: "32"

logger:

api:
  encryption:
    key: !secret api_encryption_key

ota:
  - platform: esphome
    password: "240fb0b4f8f54be4a23e9c8031379c7c"

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  use_address: capof-gateway-v2.home
  ap:
    ssid: "Capof-Gateway-V2"
    password: "KeHGR1kPyEqL"

captive_portal:

packages:
  remote_package_files:
    url: https://github.com/PedroKTFC/esphome-tesla-ble/
    path: packages
    files: [common.yml, project.yml, client.yml, base.yml]
    refresh: 0d
  board: github://capof1000/guition-tesla-ble/boards/guition-esp32-s3-4848s040.yaml

globals:
  - id: tesla_paired
    type: bool
    restore_value: false
    initial_value: 'false'

image:
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/tesla/model%20Y/charger_unplugged.jpg
    id: img_unplugged
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/tesla/model%20Y/charger_plugged.jpg
    id: img_plugged
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/tesla/model%20Y/charger_charging.jpg
    id: img_charging
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/parametres.jpg
    id: img_params
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/wifi/pas-de-wifi.jpg
    id: img_wifi_none
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/wifi/signal-wi-fi-0-25.jpg
    id: img_wifi_0_25
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/wifi/signal-wi-fi-25-50.jpg
    id: img_wifi_25_50
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/wifi/signal-wi-fi-50-75.jpg
    id: img_wifi_50_75
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/wifi/signal-wi-fi-75-100.jpg
    id: img_wifi_75_100
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/bluetouth/pas-de-bluetouth.jpg
    id: img_ble_none
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/bluetouth/bluetouth-0-25.jpg
    id: img_ble_0_25
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/bluetouth/bluetouth-25-50.jpg
    id: img_ble_25_50
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/bluetouth/bluetouth-50-75.jpg
    id: img_ble_50_75
    type: RGB565
  - file: https://raw.githubusercontent.com/capof1000/guition-tesla-ble/newteslalib/images/bluetouth/bluetouth-75-100.jpg
    id: img_ble_75_100
    type: RGB565

number:
  - platform: template
    name: "Screen GTW backlight"
    id: screen_brightness_config
    min_value: 55
    max_value: 100
    step: 1
    initial_value: 80
    optimistic: true
    restore_value: true
    entity_category: config
    on_value:
      then:
        - light.control: { id: display_backlight, brightness: !lambda "return x / 100.0;" }

  - platform: template
    name: "Screen GTW delay"
    id: screen_timeout_config
    min_value: 15
    max_value: 3600
    step: 1
    initial_value: 60
    optimistic: true
    restore_value: true
    entity_category: config
    on_value:
      then:
        - lvgl.label.update:
            id: delay_value_label
            text: !lambda 'static char buf[20]; sprintf(buf, "%.0f s", x); return buf;'
        - script.execute: screen_timeout_timer

select:
  - platform: template
    id: mode_charge
    name: "Mode Charge Tesla"
    optimistic: true
    restore_value: true
    options:
      - "manual"
      - "solar"
      - "forced"
    initial_option: "manual"
    on_value:
      then:
        - script.execute: update_mode_buttons

interval:
  - interval: 10s
    then:
      - lambda: |-
          if (!id(ble_signal).has_state()) {
            id(tesla_paired) = false;
          }
          int bucket;
          float rssi = id(ble_signal).state;
          if      (rssi <= -80) bucket = 0;
          else if (rssi <= -70) bucket = 1;
          else if (rssi <= -60) bucket = 2;
          else                  bucket = 3;
          static int last_bucket = -1;
          if (bucket == last_bucket) return;
          last_bucket = bucket;
          id(update_ble_icon).execute();

  - interval: 30s
    then:
      - lambda: |-
          if (!id(esphome_tesla_ble_wifi_signal).has_state()) return;
          float rssi = id(esphome_tesla_ble_wifi_signal).state;
          int bucket;
          if      (rssi <= -80) bucket = 0;
          else if (rssi <= -70) bucket = 1;
          else if (rssi <= -60) bucket = 2;
          else                   bucket = 3;
          static int last_bucket_wifi = -1;
          if (bucket == last_bucket_wifi) return;
          last_bucket_wifi = bucket;
          id(update_wifi_icon).execute();

tesla_ble_vehicle:
  charge_state:
    id: charge_state
    on_value:
      then:
        - lvgl.label.update:
            id: charge_level_label
            text: !lambda 'static char buf[10]; if(isnan(x)) return "-- %"; sprintf(buf, "%.0f %%", x); return buf;'
        - lvgl.arc.update:
            id: charge_level_arc
            value: !lambda "return x;"

  max_soc:
    id: max_soc
    on_value:
      then:
        - if:
            condition: { lambda: 'return !isnan(x);' }
            then:
              - lvgl.label.update:
                  id: charge_limit_label
                  text: !lambda 'static char buf[32]; if(isnan(x)) return "-- %"; sprintf(buf, "Limite de la recharge %.0f %%", x); return buf;'
              - lvgl.arc.update:
                  id: charge_limit_arc
                  value: !lambda "return x;"

  charging_state:
    id: charging_state
    on_value:
      then:
        - lambda: |-
            if (!x.empty()) {
              id(tesla_paired) = true;
              id(update_ble_icon).execute();
            }
        - script.execute: update_vehicle_image
        - lvgl.label.update:
            id: charging_label
            text: !lambda |-
              if (x.empty()) return std::string("");
              return x;

  max_amps:
    id: max_amps
    on_value:
      then:
        - lambda: |-
            if (isnan(x)) return;
            static int last = -1;
            int v = (int)x;
            if (v == last) return;
            last = v;
        - lvgl.slider.update:
            id: amps_slider
            value: !lambda "return (int)x;"
        - lvgl.label.update:
            id: charge_current_label
            text: !lambda |-
              static char buf[12];
              snprintf(buf, sizeof(buf), "%d A", (int)x);
              return buf;

font:
  - file: { type: gfonts, family: Roboto }
    id: font_main
    size: 24
    glyphs: ' !"#$%&''()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~°éèàçêëîïôûù'

script:
  - id: update_vehicle_image
    then:
      - lvgl.image.update:
          id: vehicle_image_widget
          src: !lambda |-
            if (id(charging_state).state == "Charging") return img_charging;
            if (id(is_charge_flap_open).state) return img_plugged;
            return img_unplugged;

  - id: screen_timeout_timer
    mode: restart
    then:
      - lvgl.resume:
      - script.execute: update_wifi_icon
      - script.execute: update_ble_icon
      - light.turn_on:
          id: display_backlight
          brightness: !lambda "return id(screen_brightness_config).state / 100.0;"
      - delay: !lambda "return id(screen_timeout_config).state * 1000;"
      - light.turn_off:
          id: display_backlight
          transition_length: 2s
      - lvgl.pause:

  - id: debounce_tesla_limit
    mode: restart
    parameters:
      value: float
    then:
      - delay: 500ms
      - lambda: |-
          id(tesla_ble_vehicle_id).sendCarServerVehicleActionMessage(SET_CHARGING_LIMIT, (int)value);

  - id: update_wifi_icon
    then:
      - lvgl.image.update:
          id: wifi_icon_widget
          src: !lambda |-
            if (!id(esphome_tesla_ble_wifi_signal).has_state())
              return img_wifi_none;
            float rssi = id(esphome_tesla_ble_wifi_signal).state;
            if      (rssi <= -80) return img_wifi_0_25;
            else if (rssi <= -70) return img_wifi_25_50;
            else if (rssi <= -60) return img_wifi_50_75;
            else                   return img_wifi_75_100;

  - id: update_ble_icon
    then:
      - lvgl.image.update:
          id: ble_icon_widget
          src: !lambda |-
            if (!id(ble_signal).has_state())
              return img_ble_none;
            float rssi = id(ble_signal).state;
            if      (rssi <= -80) return img_ble_0_25;
            else if (rssi <= -70) return img_ble_25_50;
            else if (rssi <= -60) return img_ble_50_75;
            else                  return img_ble_75_100;
      - lambda: |-
          auto obj = id(ble_container);
          if (!id(tesla_paired)) {
            lv_obj_set_style_outline_width(obj, 3, LV_PART_MAIN);
            lv_obj_set_style_outline_color(obj, lv_color_hex(0xFF0000), LV_PART_MAIN);
            lv_obj_set_style_outline_opa(obj, LV_OPA_COVER, LV_PART_MAIN);
          } else {
            lv_obj_set_style_outline_width(obj, 0, LV_PART_MAIN);
          }

  - id: update_mode_buttons
    mode: single
    then:
      - lambda: |-
          std::string mode = id(mode_charge).current_option();
              
          lv_color_t active_color = lv_color_hex(0x2ecc71);
          lv_color_t inactive_color = lv_color_hex(0x333333);
          if (mode == "manual") {
            lv_obj_set_style_bg_color(id(btn_manual), active_color, LV_PART_MAIN);
            lv_obj_set_style_bg_color(id(btn_solar), inactive_color, LV_PART_MAIN);
            lv_obj_set_style_bg_color(id(btn_forced), inactive_color, LV_PART_MAIN);
            lv_obj_clear_flag(id(more_amps_button), LV_OBJ_FLAG_HIDDEN);
            lv_obj_clear_flag(id(less_amps_button), LV_OBJ_FLAG_HIDDEN);
            lv_obj_clear_flag(id(charge_toggle_button), LV_OBJ_FLAG_HIDDEN);
          } else if (mode == "solar") {
            lv_obj_set_style_bg_color(id(btn_manual), inactive_color, LV_PART_MAIN);
            lv_obj_set_style_bg_color(id(btn_solar), active_color, LV_PART_MAIN);
            lv_obj_set_style_bg_color(id(btn_forced), inactive_color, LV_PART_MAIN);
            lv_obj_add_flag(id(more_amps_button), LV_OBJ_FLAG_HIDDEN);
            lv_obj_add_flag(id(less_amps_button), LV_OBJ_FLAG_HIDDEN);
            lv_obj_add_flag(id(charge_toggle_button), LV_OBJ_FLAG_HIDDEN);
          } else if (mode == "forced") {
            lv_obj_set_style_bg_color(id(btn_manual), inactive_color, LV_PART_MAIN);
            lv_obj_set_style_bg_color(id(btn_solar), inactive_color, LV_PART_MAIN);
            lv_obj_set_style_bg_color(id(btn_forced), active_color, LV_PART_MAIN);
            lv_obj_add_flag(id(more_amps_button), LV_OBJ_FLAG_HIDDEN);
            lv_obj_add_flag(id(less_amps_button), LV_OBJ_FLAG_HIDDEN);
            lv_obj_add_flag(id(charge_toggle_button), LV_OBJ_FLAG_HIDDEN);
          }

esphome:
  on_boot:
    priority: -100
    then:
      - light.turn_on:
          id: display_backlight
          brightness: 100%
      - delay: 1s
      - script.execute: update_ble_icon
      - script.execute: screen_timeout_timer

lvgl:
  displays: tft_display
  buffer_size: 10%
  on_all_events:
    - then:
        - script.execute: screen_timeout_timer

  pages:
    - id: main_page
      bg_color: 0xFFFFFF
      widgets:

        - arc:
            id: charge_limit_arc
            align: CENTER
            width: 320
            height: 320
            start_angle: 150
            end_angle: 30
            arc_width: 12
            indicator: { arc_color: 0x00AEEF, arc_width: 12 }
            adjustable: true
            on_release:
              then:
                - lambda: |-
                    int var_x = lv_arc_get_value(id(charge_limit_arc));
                    id(tesla_ble_vehicle_id)->sendCarServerVehicleActionMessage(SET_CHARGING_LIMIT, var_x);

        - button:
            id: more_amps_button
            align: RIGHT_MID
            x: -10
            y: -150
            width: 35
            height: 35
            bg_opa: 0%
            border_opa: 0%
            text: "+"
            text_font: font_main
            text_color: 0x888888
            on_click:
              then:
                - lvgl.slider.update:
                    id: amps_slider
                    value: !lambda |-
                      int val = lv_slider_get_value(id(amps_slider));
                      int new_val = (val < 32) ? val + 1 : val;
                      id(tesla_ble_vehicle_id)->sendCarServerVehicleActionMessage(SET_CHARGING_AMPS, new_val);
                      return new_val;

        - button:
            id: less_amps_button
            align: RIGHT_MID
            x: -10
            y: 160
            width: 35
            height: 35
            bg_opa: 0%
            border_opa: 0%
            text: "-"
            text_font: font_main
            text_color: 0x888888
            on_click:
              then:
                - lvgl.slider.update:
                    id: amps_slider
                    value: !lambda |-
                      int val = lv_slider_get_value(id(amps_slider));
                      int new_val = (val > 5) ? val - 1 : val;
                      id(tesla_ble_vehicle_id)->sendCarServerVehicleActionMessage(SET_CHARGING_AMPS, new_val);
                      return new_val;

        - slider:
            id: amps_slider
            width: 20
            height: 250
            align: RIGHT_MID
            x: -20
            min_value: 0
            max_value: 32
            bg_color: 0x333333
            indicator:
              bg_color: 0x2ECC71
            knob:
              bg_color: 0xFFFFFF
              radius: 5
            on_value:
              then:
                - lvgl.label.update:
                    id: charge_current_label
                    text: !lambda |-
                      static const int base_y = 125;
                      static const int step = 8;
                      lv_obj_set_y(id(charge_current_label), base_y - (step * (int)x));
                      static char buf[12];
                      snprintf(buf, sizeof(buf), "%d A", (int)x);
                      return buf;

        - label:
            id: charge_current_label
            align: RIGHT_MID
            x: -15
            text: "-- A"
            text_font: font_main
            text_color: 0x888888

        - label:
            id: charge_limit_label
            align: CENTER
            y: 140
            text: "-- %"
            #text: "Check pairing"
            text_font: font_main
            text_color: 0x888888

        - label:
            id: charging_label
            align: CENTER
            y: 110
            text: ""
            text_font: font_main
            text_color: 0x888888

        - arc:
            id: charge_level_arc
            align: CENTER
            width: 320
            height: 320
            start_angle: 150
            end_angle: 30
            arc_width: 12
            bg_opa: 0%
            adjustable: false
            indicator: { arc_color: 0x2ECC71, arc_width: 13 }

        - image:
            id: vehicle_image_widget
            src: img_unplugged
            align: CENTER
            zoom: 0.75

        - button:
            id: charge_toggle_button
            align: CENTER
            width: 240
            height: 133
            bg_opa: 0%
            border_opa: 0%
            border_width: 0
            shadow_width: 0
            on_click:
              then:
                - switch.toggle: sw_charger

        - obj:
            height: 60
            width: 100%
            align: TOP_MID
            bg_opa: 0%
            scrollable: false
            # Désactivation du clipping pour laisser l'outline déborder du parent si besoin
            clip_corner: false
            widgets:
              - button:
                  width: 60
                  height: 50
                  align: LEFT_MID
                  x: 10
                  bg_opa: 0%
                  border_opa: 0%
                  on_click:
                    then:
                      - lvgl.slider.update:
                          id: brightness_slider
                          value: !lambda "return id(screen_brightness_config).state;"
                      - lvgl.slider.update:
                          id: timeout_slider
                          value: !lambda "return id(screen_timeout_config).state;"
                      - lvgl.label.update:
                          id: wifi_signal_label
                          text: !lambda |-
                            if (id(esphome_tesla_ble_wifi_signal).has_state())
                              return str_sprintf("%.0f dBm", id(esphome_tesla_ble_wifi_signal).state);
                            return std::string("--");
                      - lvgl.label.update:
                          id: ble_signal_label
                          text: !lambda |-
                            if (id(ble_signal).has_state())
                              return str_sprintf("%.0f dBm", id(ble_signal).state);
                            return std::string("--");
                      - lvgl.label.update:
                          id: uptime_label
                          text: !lambda |-
                            if (id(esphome_tesla_ble_uptime).has_state()) {
                              int total_seconds = (int)id(esphome_tesla_ble_uptime).state;
                              int days = total_seconds / 86400;
                              int hours = (total_seconds % 86400) / 3600;
                              int minutes = (total_seconds % 3600) / 60;
                              if (days > 0)
                                return str_sprintf("%dj %dh %dm", days, hours, minutes);
                              return str_sprintf("%dh %dm", hours, minutes);
                            }
                            return std::string("--");
                      - lvgl.page.show: settings_page
                  widgets: [ image: { src: img_params, align: CENTER } ]

              - image: { id: wifi_icon_widget, src: img_wifi_none, align: RIGHT_MID, x: -90 }

              # LE CONTENEUR BLE CORRIGÉ
              - obj:
                  id: ble_container
                  width: 45
                  height: 45
                  align: RIGHT_MID
                  x: -145
                  bg_opa: 0%
                  # Utilisation de l'OUTLINE (contour extérieur)
                  outline_width: 3
                  outline_color: 0xFF0000
                  radius: 5
                  widgets:
                    - image:
                        id: ble_icon_widget
                        src: img_ble_none
                        align: CENTER

              - label: { id: charge_level_label, align: RIGHT_MID, x: -15, text: "-- %", text_font: font_main }

        - obj:
            height: 60
            width: 100%
            align: BOTTOM_MID
            bg_opa: 0%
            scrollable: false
            widgets:
              - button:
                  id: btn_manual
                  width: 120
                  height: 100%
                  align: LEFT_MID
                  on_click:
                    then:
                      - select.set: { id: mode_charge, option: "manual" }
                  widgets:
                    - label:
                        text: "Manuel"
                        align: CENTER
                        text_font: font_main
                        text_color: 0xFFFFFF
              - button:
                  id: btn_solar
                  width: 120
                  height: 100%
                  align: CENTER
                  on_click:
                    then:
                      - select.set: { id: mode_charge, option: "solar" }
                  widgets:
                    - label:
                        text: "Solaire"
                        align: CENTER
                        text_font: font_main
                        text_color: 0xFFFFFF
              - button:
                  id: btn_forced
                  width: 120
                  height: 100%
                  align: RIGHT_MID
                  on_click:
                    then:
                      - select.set: { id: mode_charge, option: "forced" }
                  widgets:
                    - label:
                        text: "Forcé"
                        align: CENTER
                        text_font: font_main
                        text_color: 0xFFFFFF

    - id: settings_page
      widgets:
        - obj:
            width: 100%
            height: 100%
            bg_color: 0x1A1A1A
            widgets:
              - button:
                  align: TOP_RIGHT
                  x: -15
                  y: 10
                  width: 50
                  height: 40
                  bg_color: 0xE53935
                  on_click: { then: [ lvgl.page.show: main_page ] }
                  widgets: [ label: { text: "X", text_font: font_main, align: CENTER } ]

              - label:
                  text: "Luminosité"
                  align: TOP_LEFT
                  x: 30
                  y: 60
                  text_color: 0xFFFFFF
                  text_font: font_main
              - slider:
                  id: brightness_slider
                  align: TOP_MID
                  y: 100
                  width: 80%
                  min_value: 55
                  max_value: 100
                  on_value: { then: [ number.set: { id: screen_brightness_config, value: !lambda "return x;" } ] }

              - label:
                  text: "Timeout"
                  align: TOP_LEFT
                  x: 30
                  y: 140
                  text_color: 0xFFFFFF
                  text_font: font_main
              - label:
                  id: delay_value_label
                  align: TOP_RIGHT
                  x: -30
                  y: 140
                  text: "60 s"
                  text_color: 0xFFFFFF
                  text_font: font_main
              - slider:
                  id: timeout_slider
                  align: TOP_MID
                  y: 180
                  width: 80%
                  min_value: 15
                  max_value: 3600
                  value: !lambda "return id(screen_timeout_config).state;"
                  on_value:
                    then:
                      - number.set:
                          id: screen_timeout_config
                          value: !lambda "return x;"
                      - lvgl.label.update:
                          id: delay_value_label
                          text: !lambda "return str_sprintf(\"%.0f s\", x);"

              - label:
                  text: "Wifi"
                  align: TOP_LEFT
                  x: 30
                  y: 220
                  text_color: 0xFFFFFF
                  text_font: font_main
              - label:
                  id: wifi_signal_label
                  text_font: font_main
                  text_color: 0xFFFFFF
                  align: TOP_RIGHT
                  x: -30
                  y: 220
                  text: !lambda |-
                    if (id(esphome_tesla_ble_wifi_signal).has_state())
                      return str_sprintf("%.0f dBm", id(esphome_tesla_ble_wifi_signal).state);
                    return std::string("--");

              - label:
                  text: "BLE"
                  align: TOP_LEFT
                  x: 30
                  y: 260
                  text_color: 0xFFFFFF
                  text_font: font_main
              - label:
                  id: ble_signal_label
                  text_font: font_main
                  text_color: 0xFFFFFF
                  align: TOP_RIGHT
                  x: -30
                  y: 260

              - label:
                  text: "Uptime"
                  align: TOP_LEFT
                  x: 30
                  y: 300
                  text_color: 0xFFFFFF
                  text_font: font_main
              - label:
                  id: uptime_label
                  text_font: font_main
                  text_color: 0xFFFFFF
                  align: LV_ALIGN_TOP_RIGHT
                  x: -30
                  y: 300
                  text: !lambda |-
                    if (id(esphome_tesla_ble_uptime).has_state()) {
                      int total_seconds = (int)id(esphome_tesla_ble_uptime).state;
                      int days = total_seconds / 86400;
                      int hours = (total_seconds % 86400) / 3600;
                      int minutes = (total_seconds % 3600) / 60;
                      if (days > 0)
                        return str_sprintf("%dj %dh %dm", days, hours, minutes);
                      return str_sprintf("%dh %dm", hours, minutes);
                    }
                    return std::string("--");
